/* =====================================================
   Delta Robot - G-code Sender
   Современная светлая тема
   ===================================================== */

/* --- Главное окно --- */
QMainWindow {
    background-color: #fafafa;
}

/* --- DockWidget (боковые панели) --- */
QDockWidget {
    color: #2c3e50;
    font-size: 11pt;
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

/* Крупные заголовки доков */
QDockWidget::title {
    background: qlineargradient(x1: 0, y1: 0, x2: 0, y2: 1,
                                stop: 0 #3498db, stop: 1 #2980b9);
    color: white;
    padding: 8px 15px;
    font-size: 11pt;
    font-weight: bold;
    border: none;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background-color: rgba(255, 255, 255, 0.2);
    border: none;
    padding: 3px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background-color: rgba(255, 255, 255, 0.3);
}

/* --- Кнопки --- */
QPushButton {
    background-color: #ecf0f1;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    padding: 6px 12px;
    min-height: 28px;
    font-size: 10pt;
    color: #111;
    font-weight: 600;
}

QPushButton:hover {
    background-color: #d5dbdb;
    border-color: #95a5a6;
    color: #000;
}

QPushButton:pressed {
    background-color: #aed6f1;
    border-color: #3498db;
}

QPushButton:disabled {
    background-color: #f8f9fa;
    color: #bdc3c7;
    border-color: #e5e7e9;
}

/* --- Поля ввода --- */
QLineEdit, QPlainTextEdit, QTextEdit {
    background-color: #fafafa;
    border: 1px solid #d5dbdb;
    border-radius: 4px;
    padding: 6px 10px;
    font-size: 10pt;
    color: #111;
    selection-background-color: #3498db;
    selection-color: white;
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus {
    border-color: #3498db;
    border-width: 2px;
}

/* --- ComboBox --- */
QComboBox {
    background-color: white;
    border: 1px solid #d5dbdb;
    border-radius: 4px;
    padding: 6px 30px 6px 10px;
    font-size: 10pt;
    min-height: 28px;
}

QComboBox:hover {
    border-color: #95a5a6;
}

QComboBox:focus {
    border-color: #3498db;
    border-width: 2px;
}

QComboBox::drop-down {
    border: none;
    width: 25px;
    background-color: #ecf0f1;
    border-left: 1px solid #d5dbdb;
}

QComboBox::drop-down:hover {
    background-color: #d5dbdb;
}

QComboBox QAbstractItemView {
    background-color: white;
    border: 1px solid #bdc3c7;
    selection-background-color: #3498db;
    selection-color: white;
    padding: 4px;
}

/* --- SpinBox --- */
QDoubleSpinBox, QSpinBox {
    background-color: white;
    border: 1px solid #d5dbdb;
    border-radius: 4px;
    padding: 6px;
    font-size: 10pt;
    min-height: 28px;
}

QDoubleSpinBox:hover, QSpinBox:hover {
    border-color: #95a5a6;
}

QDoubleSpinBox:focus, QSpinBox:focus {
    border-color: #3498db;
    border-width: 2px;
}

QDoubleSpinBox::up-button, QDoubleSpinBox::down-button,
QSpinBox::up-button, QSpinBox::down-button {
    background-color: #ecf0f1;
    border: none;
    width: 20px;
}

QDoubleSpinBox::up-button:hover, QDoubleSpinBox::down-button:hover,
QSpinBox::up-button:hover, QSpinBox::down-button:hover {
    background-color: #d5dbdb;
}

/* --- Label --- */
QLabel {
    color: #2c3e50;
    font-size: 10pt;
}

/* --- Тулбар --- */
QToolBar {
    background-color: #ecf0f1;
    border: none;
    border-bottom: 1px solid #bdc3c7;
    spacing: 5px;
    padding: 6px;
}

QToolButton {
    background-color: transparent;
    border: none;
    padding: 5px;
    border-radius: 3px;
    color: #111;
    font-weight: 600;
}

QToolButton:hover {
    background-color: #d5dbdb;
    color: #000;
}

QToolButton:pressed {
    background-color: #aed6f1;
}

/* --- Меню --- */
QMenuBar {
    background-color: #ecf0f1;
    border: none;
    border-bottom: 1px solid #bdc3c7;
    padding: 3px 0px;
}

QMenuBar::item {
    padding: 6px 12px;
    font-size: 10pt;
    color: #111;
}

QMenuBar::item:selected {
    background-color: #aed6f1;
    border-radius: 3px;
}

QMenu {
    background-color: white;
    border: 1px solid #bdc3c7;
    padding: 4px;
}

QMenu::item {
    padding: 6px 35px 6px 25px;
    font-size: 10pt;
    color: #111;
}

QMenu::item:selected {
    background-color: #3498db;
    color: white;
}

QMenu::separator {
    height: 1px;
    background-color: #ecf0f1;
    margin: 6px 0px;
}

/* --- Статус бар --- */
QStatusBar {
    background-color: #ecf0f1;
    border: none;
    border-top: 1px solid #bdc3c7;
    color: #34495e;
    font-size: 9pt;
}

/* --- Splitters --- */
QSplitter::handle {
    background-color: #bdc3c7;
}

QSplitter::handle:horizontal {
    width: 3px;
}

QSplitter::handle:vertical {
    height: 3px;
}

QSplitter::handle:hover {
    background-color: #95a5a6;
}

/* --- ScrollBar --- */
QScrollBar:vertical {
    background-color: #ecf0f1;
    width: 12px;
    border: none;
}

QScrollBar::handle:vertical {
    background-color: #bdc3c7;
    min-height: 20px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #95a5a6;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #ecf0f1;
    height: 12px;
    border: none;
}

QScrollBar::handle:horizontal {
    background-color: #bdc3c7;
    min-width: 20px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #95a5a6;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* --- G-code Editor --- */
GCodeView {
    background-color: #fafafa;
    color: #111;
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 9pt;
    line-height: 1.2;
}

/* Line numbers styling (if implemented) */
GCodeView QWidget[objectName="lineNumberArea"] {
    background-color: #ecf0f1;
    color: #7f8c8d;
    border-right: 1px solid #bdc3c7;
    font-family: "Consolas", "Monaco", "Courier New", monospace;
    font-size: 9pt;
}

/* --- Console Input Row --- */
#ConsoleInputRow QLineEdit {
    padding: 6px 8px;
}

#ConsoleInputRow QPushButton {
    padding: 6px 10px;
}

/* --- Jog Panel: Dark Labels and Inputs --- */
#JogPanel QLabel,
#JogPanel QLineEdit,
#JogPanel QSpinBox,
#JogPanel QDoubleSpinBox {
    color: #111;
}

/* Darker on hover for better visibility */
#JogPanel QLineEdit:hover,
#JogPanel QSpinBox:hover,
#JogPanel QDoubleSpinBox:hover {
    color: #000;
}

/* Placeholder text styling */
#JogPanel QLineEdit::placeholder {
    color: #444;
}

/* Specific targeting for step and feedrate labels */
#JogStepLabel, #JogFeedrateLabel {
    color: #111;
    font-weight: 600;
}

/* --- Bottom spacer dock (visual cleanup) --- */
#BottomSpacerDock {
    border: none;
    background: transparent;
}

/* =====================================================
   Компактный режим (MainCompactView, 800×480)
   ===================================================== */

#MainCompactView {
    background-color: #f5f7f9;
    padding: 4px;
    font-size: 9pt;
}

QWidget[class~="compact-column"] {
    padding: 2px;
}

QGroupBox[class~="compact-groupbox"] {
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    margin: 2px;
    padding: 6px;
}

QGroupBox[class~="compact-groupbox"]::title {
    subcontrol-origin: margin;
    left: 6px;
    padding: 0px 4px;
    font-size: 9pt;
    color: #1f2a33;
}

QPushButton[class~="compact-button"] {
    min-height: 30px;
    max-height: 30px;
    padding: 0 10px;
    font-size: 9pt;
}

QPushButton[class~="compact-jog-button"] {
    min-width: 40px;
    min-height: 40px;
    max-width: 44px;
    max-height: 44px;
    padding: 0px;
    margin: -1px;
    font-weight: 600;
    font-size: 9pt;
}

QLineEdit[class~="compact-coord-field"] {
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
    letter-spacing: 0.5px;
    padding: 4px 6px;
}

QPlainTextEdit[class~="compact-console-history"] {
    background-color: #111418;
    color: #e5e9f0;
    border-color: #2f3742;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
}

QLineEdit[class~="compact-console-input"] {
    background-color: #1a1f24;
    color: #f0f3f8;
    border-color: #2f3742;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 9pt;
}

QWidget[class~="compact-console-row"] QPushButton {
    min-height: 30px;
    max-height: 30px;
}

QSplitter[class~="compact-splitter"]::handle {
    background-color: #d0d5da;
    margin: 0;
}

QSplitter[class~="compact-splitter"]::handle:horizontal {
    width: 2px;
}

QSplitter[class~="compact-splitter"]::handle:vertical {
    height: 2px;
}

QWidget[class~="compact-tight"] {
    margin: 0;
    padding: 2px;
}

/* Квадратные кнопки управления G-кодом */
#StartCycleButton {
    min-width: 60px;
    min-height: 60px;
    max-width: 60px;
    max-height: 60px;
    background-color: #27ae60;
    color: white;
    border: 2px solid #229954;
    border-radius: 4px;
    font-size: 8pt;
    font-weight: 600;
    padding: 2px;
}

#StartCycleButton:hover {
    background-color: #2ecc71;
    border-color: #27ae60;
}

#StartCycleButton:pressed {
    background-color: #229954;
    border-color: #1e8449;
}

#StartCycleButton:disabled {
    background-color: #95a5a6;
    border-color: #7f8c8d;
    color: #ecf0f1;
}

#StopButton {
    min-width: 60px;
    min-height: 60px;
    max-width: 60px;
    max-height: 60px;
    background-color: #e74c3c;
    color: white;
    border: 2px solid #c0392b;
    border-radius: 4px;
    font-size: 8pt;
    font-weight: 600;
    padding: 2px;
}

#StopButton:hover {
    background-color: #ec7063;
    border-color: #e74c3c;
}

#StopButton:pressed {
    background-color: #c0392b;
    border-color: #a93226;
}

#StopButton:disabled {
    background-color: #95a5a6;
    border-color: #7f8c8d;
    color: #ecf0f1;
}

#LoadCodeButton {
    min-width: 60px;
    min-height: 60px;
    max-width: 60px;
    max-height: 60px;
    background-color: #ecf0f1;
    color: #2c3e50;
    border: 2px solid #bdc3c7;
    border-radius: 4px;
    font-size: 7pt;
    font-weight: 600;
    padding: 2px;
}

#LoadCodeButton:hover {
    background-color: #d5dbdb;
    border-color: #95a5a6;
}

#LoadCodeButton:pressed {
    background-color: #aed6f1;
    border-color: #3498db;
}

#LoadCodeButton:disabled {
    background-color: #f8f9fa;
    color: #bdc3c7;
    border-color: #e5e7e9;
}

#LineByLineButton {
    min-width: 60px;
    min-height: 60px;
    max-width: 60px;
    max-height: 60px;
    background-color: #ecf0f1;
    color: #2c3e50;
    border: 2px solid #bdc3c7;
    border-radius: 4px;
    font-size: 7pt;
    font-weight: 600;
    padding: 2px;
}

#LineByLineButton:hover {
    background-color: #d5dbdb;
    border-color: #95a5a6;
}

#LineByLineButton:pressed {
    background-color: #aed6f1;
    border-color: #3498db;
}

#LineByLineButton:disabled {
    background-color: #f8f9fa;
    color: #bdc3c7;
    border-color: #e5e7e9;
}

/* Компактные поля ввода параметров движения */
#MainCompactView QGroupBox[title="Параметры движения"] QLineEdit {
    max-width: 60px;
    min-width: 50px;
    padding: 2px 4px;
    font-size: 8pt;
}

#MainCompactView QGroupBox[title="Параметры движения"] QLabel {
    font-size: 8pt;
    padding: 0px 2px;
}

